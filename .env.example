# 数据库
DATABASE_URL=./data/prd.db

# Session 加密密钥(至少 32 字符,生产环境务必改掉)
SESSION_SECRET=change-me-to-a-random-32-char-string-please

# Cowork 注册邀请码；兼容原有配置，也可用 COWORK_INVITE_CODE 单独设置
INVITE_CODE=PRD2026

# 招采空间使用独立邀请码；未配置时禁止在招采空间注册
PROCUREMENT_INVITE_CODE=

# 数据目录
DATA_DIR=./data

# 上传体积限制(MB)
MAX_UPLOAD_SIZE_MB=50
