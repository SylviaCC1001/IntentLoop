{
  "name": "intent-loop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:db": "tsx src/lib/db/smoke.ts",
    "test:comments": "tsx src/lib/comments/smoke.ts",
    "test:permissions": "tsx src/lib/auth/permissions-smoke.ts",
    "test:prototype-annotations": "tsx src/lib/prototype-annotations/smoke.ts",
    "test:proto": "tsx src/app/proto/smoke.ts",
    "test:pages": "tsx src/app/pages-smoke.ts",
    "test:tenants": "tsx src/lib/tenants/smoke.ts",
    "test:smoke": "npm run test:db && npm run test:comments && npm run test:permissions && npm run test:proto && npm run test:prototype-annotations",
    "deploy:windows:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/start-intentloop.ps1",
    "deploy:windows:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/backup-intentloop.ps1",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "db:seed": "tsx src/lib/db/seed.ts",
    "setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@uiw/react-md-editor": "^4.0.5",
    "adm-zip": "^0.5.16",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^7.0.0",
    "drizzle-orm": "^0.36.4",
    "highlight.js": "^11.10.0",
    "isomorphic-git": "^1.27.1",
    "jose": "^5.9.6",
    "katex": "^0.16.11",
    "lucide-react": "^0.460.0",
    "mermaid": "^11.4.0",
    "next": "15.5.18",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/diff": "^6.0.0",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9.14.0",
    "eslint-config-next": "15.5.18",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
